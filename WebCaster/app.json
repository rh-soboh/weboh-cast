{
  "expo": {
    "name": "WebCaster",
    "slug": "webcaster",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121217",
    "splash": {
      "backgroundColor": "#121217"
    },
    "ios": {
      "bundleIdentifier": "com.weboh.webcaster",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "WebCaster needs access to your local network to discover casting devices.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_airplay._tcp"
        ],
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.weboh.webcaster",
      "adaptiveIcon": {
        "backgroundColor": "#121217"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "plugins": [
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "fcdda867-7e5c-4e86-896a-73f18d2c1417"
      }
    }
  }
}
